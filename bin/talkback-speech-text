#!/usr/bin/env python3
"""Turn a Markdown reply into text that reads well aloud.

Reads Markdown on stdin and writes one line of plain sentences. Piper only
pauses between sentences inside a line, so everything goes on one line and
every heading, list item and paragraph ends like a sentence.
"""

import re
import sys

ABBREVIATIONS = {
    "e.g.": "for example",
    "i.e.": "that is",
    "etc.": "and so on",
    "vs.": "versus",
    "approx.": "about",
}

SYMBOLS = [
    ("→", " to "),
    ("->", " to "),
    ("←", " from "),
    ("⇒", " so "),
    ("·", ", "),
    ("•", ", "),
    ("—", ", "),
    ("–", " to "),
    ("…", "."),
    ("&", " and "),
    ("≈", " about "),
    ("≥", " at least "),
    ("≤", " at most "),
]

SENTENCE_END = re.compile(r"[.!?:;]$")


def speak_path(path):
    """A path reads as its last part: ~/.config/hypr/bindings.lua is bindings.lua."""
    path = path.rstrip("/")
    return path.rsplit("/", 1)[-1] or path


def inline(text):
    # Links keep their words; bare URLs become their site.
    text = re.sub(r"!\[([^\]]*)\]\([^)]*\)", r"\1", text)
    text = re.sub(r"\[([^\]]+)\]\([^)]*\)", r"\1", text)
    text = re.sub(r"https?://(?:www\.)?([^/\s)]+)\S*", r"\1", text)

    def code(match):
        content = match.group(1).strip()
        if "/" in content and " " not in content:
            return speak_path(content)
        return content

    text = re.sub(r"`([^`]+)`", code, text)

    def bare_path(match):
        # A sentence can end right after a path; keep its full stop.
        path = match.group(0)
        stripped = path.rstrip(".")
        return speak_path(stripped) + path[len(stripped):]

    text = re.sub(r"(?<![\w.])(?:~|\.{1,2})?/(?:[\w.@+-]+/)+[\w.@+-]*", bare_path, text)

    # Bold, italics and strikethrough markers, but not underscores inside words.
    text = re.sub(r"(\*{1,3}|~~)(\S.*?\S|\S)\1", r"\2", text)
    text = re.sub(r"(?<!\w)_{1,2}(\S.*?\S|\S)_{1,2}(?!\w)", r"\1", text)

    for short, long in ABBREVIATIONS.items():
        text = re.sub(r"(?<!\w)" + re.escape(short), long, text, flags=re.IGNORECASE)

    # "on/off" reads as "on or off"; numbers like 1/2 are left to Piper.
    text = re.sub(r"\b([A-Za-z]+)/([A-Za-z]+)\b", r"\1 or \2", text)
    # "1.5×" is "1.5 times".
    text = re.sub(r"(\d)\s*×", r"\1 times", text)
    text = text.replace("×", " by ")
    for symbol, words in SYMBOLS:
        text = text.replace(symbol, words)

    text = re.sub(r"\s+([,.;:!?])", r"\1", text)
    text = re.sub(r",\s*,", ",", text)
    return re.sub(r"\s+", " ", text).strip(" ,")


def finish(sentence):
    sentence = sentence.strip()
    if not sentence:
        return ""
    if sentence.endswith(":"):
        return sentence[:-1] + "."
    return sentence if SENTENCE_END.search(sentence) else sentence + "."


def speech_text(markdown):
    sentences = []
    paragraph = []

    def flush():
        if paragraph:
            sentences.append(finish(inline(" ".join(paragraph))))
            paragraph.clear()

    in_code = False
    for raw in markdown.splitlines():
        line = raw.strip()
        if line.startswith("```") or line.startswith("~~~"):
            flush()
            in_code = not in_code
            continue
        if in_code:
            continue
        if not line:
            flush()
            continue
        # Tables and horizontal rules don't read aloud.
        if line.startswith("|") or re.fullmatch(r"[-*_]{3,}", line):
            flush()
            continue

        heading = re.match(r"#{1,6}\s+(.*)", line)
        item = re.match(r"(?:[-*+]|\d+[.)])\s+(?:\[[ xX]\]\s+)?(.*)", line)
        quote = re.match(r">\s?(.*)", line)
        if heading or item:
            flush()
            sentences.append(finish(inline((heading or item).group(1))))
        elif quote:
            paragraph.append(quote.group(1))
        else:
            paragraph.append(line)
    flush()

    return " ".join(s for s in sentences if s)


if __name__ == "__main__":
    print(speech_text(sys.stdin.read()))
