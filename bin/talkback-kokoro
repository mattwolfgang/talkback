#!/usr/bin/env python3
"""Speak with Kokoro: text on stdin, raw 16-bit mono 24 kHz audio on stdout.

Runs inside Talkback's Kokoro environment (talkback-kokoro-setup makes it):

    talkback-kokoro --voice af_heart [--speed 1.0] [--pause 0.3] < text
    talkback-kokoro --list        the voice names, one per line

Each sentence is written as soon as it's ready, so playback starts after the
first one instead of after the whole reply.
"""

import argparse
import os
import re
import sys

HOME = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "talkback", "kokoro")
MODEL = os.path.join(HOME, "kokoro-v1.0.onnx")
VOICES = os.path.join(HOME, "voices-v1.0.bin")
SAMPLE_RATE = 24000

# The first letter of a Kokoro voice name is its language.
LANGUAGES = {
    "a": "en-us",
    "b": "en-gb",
    "e": "es",
    "f": "fr-fr",
    "h": "hi",
    "i": "it",
    "j": "ja",
    "p": "pt-br",
    "z": "cmn",
}


def sentences(text):
    parts = re.split(r"(?<=[.!?])\s+", text.strip())
    return [part for part in parts if part.strip()]


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--voice", default="af_heart")
    parser.add_argument("--speed", type=float, default=1.0)
    parser.add_argument("--pause", type=float, default=0.3)
    parser.add_argument("--list", action="store_true")
    args = parser.parse_args()

    import numpy as np
    from kokoro_onnx import Kokoro

    kokoro = Kokoro(MODEL, VOICES)
    if args.list:
        print("\n".join(sorted(kokoro.get_voices())))
        return 0

    if args.voice not in kokoro.get_voices():
        print(f"Unknown Kokoro voice: {args.voice}", file=sys.stderr)
        return 1

    language = LANGUAGES.get(args.voice[:1], "en-us")
    speed = min(max(args.speed, 0.5), 2.0)
    silence = np.zeros(int(SAMPLE_RATE * max(args.pause, 0)), dtype=np.int16).tobytes()
    out = sys.stdout.buffer

    for index, sentence in enumerate(sentences(sys.stdin.read())):
        samples, _ = kokoro.create(sentence, voice=args.voice, speed=speed, lang=language)
        if index > 0:
            out.write(silence)
        out.write((np.clip(samples, -1, 1) * 32767).astype(np.int16).tobytes())
        out.flush()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        # Playback was stopped; nothing is listening any more.
        sys.exit(0)
