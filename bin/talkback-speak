#!/bin/bash
# Speaks text with Piper or Kokoro. Coding agents run it as a hook when a reply
# finishes (the hook's JSON arrives on stdin); Talkback runs it to preview voices.
#
#   talkback-speak [--agent NAME]          read the agent's last reply, if turned on
#                                          (claude, codex, grok, cursor, antigravity, omp)
#   talkback-speak --say TEXT [--engine piper|kokoro] [--voice NAME] [--speed N]
#                  [--expression N] [--rhythm N] [--pause SECONDS] [--speaker N]
#   talkback-speak --stop                  stop whatever is playing

config="${XDG_CONFIG_HOME:-$HOME/.config}/talkback/settings.conf"
voices="${XDG_DATA_HOME:-$HOME/.local/share}/piper-voices"
kokoro="${XDG_DATA_HOME:-$HOME/.local/share}/talkback/kokoro"
pidfile="${XDG_RUNTIME_DIR:-/tmp}/talkback-speak.pid"

setting() {
  sed -n "s/^$1=//p" "$config" 2>/dev/null | tail -n1
}

stop_speaking() {
  if [[ -f $pidfile ]]; then
    kill -- -"$(cat "$pidfile")" 2>/dev/null
    rm -f "$pidfile"
  fi
}

engine=$(setting engine)
voice=
speed=$(setting speed)
expression=$(setting expression)
rhythm=$(setting rhythm)
pause=$(setting pause)
speaker=
agent=claude
text=

while (($#)); do
  case $1 in
    --stop) stop_speaking; exit 0 ;;
    --say) text=$2; shift ;;
    --agent) agent=$2; shift ;;
    --engine) engine=$2; shift ;;
    --voice) voice=$2; shift ;;
    --speed) speed=$2; shift ;;
    --expression) expression=$2; shift ;;
    --rhythm) rhythm=$2; shift ;;
    --pause) pause=$2; shift ;;
    --speaker) speaker=$2; shift ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
  shift
done

if [[ -z $text ]]; then
  # Called as the hook: stay quiet unless spoken replies are on.
  [[ $(setting enabled) == false ]] && exit 0

  input=$(cat)
  case $agent in
    claude)
      # Grok and Cursor also run Claude's hooks; they have their own.
      [[ $(jq -r 'has("hookEventName") or has("cursor_version")' <<<"$input") == true ]] && exit 0
      [[ $(jq -r '.stop_hook_active // false' <<<"$input") == true ]] && exit 0
      text=$(jq -r '.last_assistant_message // empty' <<<"$input")
      if [[ -z $text ]]; then
        # Older Claude Code: pull the last assistant text from the transcript.
        transcript=$(jq -r '.transcript_path // empty' <<<"$input")
        [[ -f $transcript ]] || exit 0
        text=$(jq -rs '
          map(select(.type == "assistant")) | last | .message.content
          | if type == "array" then map(select(.type == "text") | .text) | join("\n") else . end
        ' "$transcript")
      fi
      ;;
    codex | omp)
      [[ $(jq -r '.stop_hook_active // false' <<<"$input") == true ]] && exit 0
      text=$(jq -r '.last_assistant_message // empty' <<<"$input")
      ;;
    grok)
      # Grok also fires Stop when the session closes; only a finished turn counts.
      [[ $(jq -r '.stopHookActive // false' <<<"$input") == true ]] && exit 0
      [[ $(jq -r '.reason // "end_turn"' <<<"$input") == end_turn ]] || exit 0
      text=$(jq -r '.lastAssistantMessage // empty' <<<"$input")
      ;;
    cursor)
      text=$(jq -r '.text // empty' <<<"$input")
      ;;
    antigravity)
      # Its Stop hook carries no reply, so read the model's last step from the
      # transcript (the full one when it's there, since the compact one cuts long text).
      [[ $(jq -r '.terminationReason // empty' <<<"$input") == NO_TOOL_CALL ]] || exit 0
      transcript=$(jq -r '.transcriptPath // empty' <<<"$input")
      [[ -f ${transcript%.jsonl}_full.jsonl ]] && transcript=${transcript%.jsonl}_full.jsonl
      [[ -f $transcript ]] || exit 0
      text=$(jq -rs '
        map(select(.type | tostring | endswith("PLANNER_RESPONSE"))) | last | .content // empty
      ' "$transcript")
      ;;
    *) echo "Unknown agent: $agent" >&2; exit 1 ;;
  esac
  [[ -z $text || $text == null ]] && exit 0
fi

# Markdown and symbols become plain sentences on one line: the only place
# Piper pauses between them, and what Kokoro splits into sentences.
here=$(dirname "$(readlink -f "$0")")
text=$("$here/talkback-speech-text" <<<"$text")
[[ -z $text ]] && exit 0

stop_speaking

if [[ $engine == kokoro ]]; then
  voice=${voice:-$(setting kokoroVoice)}
  voice=${voice:-af_heart}
  if [[ ! -x $kokoro/venv/bin/python ]]; then
    echo "Kokoro isn't installed. Run talkback-kokoro-setup or install it in Talkback." >&2
    exit 1
  fi
  setsid bash -c '
    "$1" -I "$2" --voice "$3" --speed "$4" --pause "$5" 2>/dev/null | aplay -q -r 24000 -f S16_LE -c 1 -t raw
    rm -f "$6"
  ' _ "$kokoro/venv/bin/python" "$here/talkback-kokoro" "$voice" "${speed:-1}" "${pause:-0.3}" "$pidfile" \
    <<<"$text" >/dev/null 2>&1 &
  echo $! >"$pidfile"
  exit 0
fi

voice=${voice:-$(setting voice)}
voice=${voice:-en_US-lessac-medium}
# Voices trained on many people pick one by number; the window saves a
# choice per voice.
speaker=${speaker:-$(setting "speaker.$voice")}
model="$voices/$voice.onnx"
if [[ ! -f $model ]]; then
  echo "Voice not installed: $voice" >&2
  exit 1
fi

# Piper takes a phoneme length, so a faster speed is a shorter length.
length=$(awk -v s="${speed:-1}" 'BEGIN { if (s <= 0) s = 1; printf "%.3f", 1 / s }')
rate=$(jq -r '.audio.sample_rate // 22050' "$model.json" 2>/dev/null)

setsid bash -c '
  piper-tts -m "$1" --length-scale "$2" --noise-scale "$3" --noise-w-scale "$4" --sentence-silence "$5" \
    --speaker "$6" --output-raw 2>/dev/null | aplay -q -r "$7" -f S16_LE -c 1 -t raw
  rm -f "$8"
' _ "$model" "$length" "${expression:-0.667}" "${rhythm:-0.8}" "${pause:-0.3}" "${speaker:-0}" "${rate:-22050}" "$pidfile" \
  <<<"$text" >/dev/null 2>&1 &
echo $! >"$pidfile"
exit 0
